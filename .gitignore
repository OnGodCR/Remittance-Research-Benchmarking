# Python environment
.venv/
__pycache__/
*.py[cod]

# SECRETS -- never commit. A leaked cloud key on GitHub gets found by automated
# scrapers within minutes and the account drained. This stays here even though
# the repo is currently private, because it will be made public at publication.
*.pem
*.key
*-key.json
keys/
secrets/
.env
gcp-credentials*.json
service-account*.json

# Infrastructure state. Contains resource IDs and can contain secrets in
# plaintext. Also merges terribly.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# Working data. SQLite is the harness's live store during runs; the committed
# archives are the two Parquet files under data/, which ARE tracked.
*.sqlite
*.sqlite-wal
*.sqlite-shm
gcp-research/data/working/

# Solidity build output -- regenerated from contracts/*.sol on every deploy
build/
artifacts/

# OS noise
.DS_Store
terraform.tfvars

gcp-research/terraform/phase3/terraform.tfvars
gcp-research/terraform/phase3/*.tfstate*
gcp-research/terraform/phase3/.terraform/

gcp-research/keys/lightning_endpoints.json

gcp-research/terraform/phase4/terraform.tfvars
gcp-research/terraform/phase4/*.tfstate*
gcp-research/terraform/phase4/.terraform/
gcp-research/keys/near_senders.json

# Rebuilt from data/raw/parts/ by analysis/rebuild_raw.py. Not stored directly:
# GitHub hard-rejects any single large-file-storage object over 2 GiB and this
# passed it at 610 runs.
gcp-research/data/raw/all_runs_raw.parquet
gcp-research/data/near_supplementary/*.sqlite
