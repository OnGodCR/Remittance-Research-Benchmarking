# Copy to terraform.tfvars and fill in. The real file is gitignored -- it
# contains your home IP, which should not be in a public repo.
project_id       = "your-gcp-project-id"

# Your current public IP. It changes every few weeks; if SSH hangs, check
#   curl -s https://ifconfig.me
# against this value before debugging anything else (RESUME_HERE.md S5 trap 4).
operator_ip_cidr = "203.0.113.4/32"

# Spot everywhere. Preemption costs ~15 minutes of rebuild; on-demand costs
# 4.5x. On Lightning a preemption also loses that host's channel state, so
# scripts/lightning_bootstrap.py is written to be re-runnable.
use_spot = true
