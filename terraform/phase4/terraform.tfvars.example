# Copy to terraform.tfvars and fill in. The real file is gitignored.
project_id       = "your-gcp-project-id"

# Your current public IP. It changes every few weeks; if SSH hangs, check
#   curl -s https://ifconfig.me
# against this before debugging anything else (README.md cloud trap 4).
operator_ip_cidr = "203.0.113.4/32"

# Spot for validators, on demand for the generator (see variables.tf).
use_spot = true
